
# Elexon BMRS API base URL (default shown)
WINDSIGHT_ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# HTTP client timeout in seconds (default: 30)
WINDSIGHT_HTTP_TIMEOUT_SECONDS=30.0

# Max retries for transient HTTP failures (default: 3)
WINDSIGHT_HTTP_MAX_RETRIES=3

# Initial retry backoff in seconds, doubles each attempt (default: 1.0)
WINDSIGHT_HTTP_RETRY_WAIT_SECONDS=1.0

# Allowed CORS origins (JSON array). Include the frontend URL.
# Development default: localhost:5173
# Docker Compose default: localhost:8080
WINDSIGHT_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Frontend Vite env vars (set at build time, not runtime)
# Leave empty to use relative URLs (Vite proxy in dev, nginx proxy in Docker)
VITE_API_BASE_URL=
